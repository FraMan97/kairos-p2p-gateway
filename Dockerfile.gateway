FROM golang:1.24-alpine AS builder
RUN apk add --no-cache git
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o gateway ./cmd/g-kairos/main.go

FROM alpine:3.19
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app

RUN addgroup -S kairos && adduser -S kairos -G kairos
COPY --from=builder /app/gateway .

USER kairos
EXPOSE 3000
ENTRYPOINT ["./gateway"]